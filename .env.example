# Official Discord bot token from the Discord Developer Portal.
# Do not use a normal user account token here.
DISCORD_BOT_TOKEN=

# Authentication: bot (Gateway) or user (read-only REST polling).
DISCORD_AUTH=bot
DISCORD_USER_TOKEN=
DISCORD_POLL_SECONDS=15

# Comma-separated channel IDs. The bot ignores every other channel.
DISCORD_CHANNEL_IDS=

# Optional startup history import. The default is live messages only.
DISCORD_HISTORY_LIMIT=0

# Optional JSONL output path, relative to this repository. Empty = stdout only.
DISCORD_MESSAGE_LOG=

LOG_LEVEL=INFO
